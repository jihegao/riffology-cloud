FROM docker.io/cloudflare/sandbox:0.12.9-python@sha256:f3c089b1bbb9dd85eeca09e20d841e6900390f45fb4e84dfbef0e9d17ddac806

USER root
RUN groupadd -g 10002 trustedpi && useradd -u 10002 -g 10002 -M -s /usr/sbin/nologin trustedpi \
    && mkdir -p /opt/riffology/project-resources /opt/riffology/runtime /opt/riffology/trusted-pi /var/lib/riffology/pi /var/lib/riffology/turns /var/lib/riffology/runtime-control \
    && chown -R root:root /opt/riffology /var/lib/riffology \
    && chmod 0755 /opt/riffology /opt/riffology/runtime /opt/riffology/trusted-pi /var/lib/riffology /var/lib/riffology/pi \
    && chown trustedpi:trustedpi /var/lib/riffology/pi /var/lib/riffology/turns \
    && chmod 0700 /var/lib/riffology/pi /var/lib/riffology/turns /var/lib/riffology/runtime-control

COPY --chown=root:root --chmod=0444 services/trusted-pi/package.json services/trusted-pi/package-lock.json /opt/riffology/
RUN cd /opt/riffology \
    && npm ci --omit=dev --ignore-scripts \
    && npm cache clean --force

COPY --chown=root:root --chmod=0444 services/browser-preview/runtime/sha256.mjs /opt/riffology/browser-preview/runtime/sha256.mjs
COPY --chown=root:root --chmod=0444 services/project-resources/text.mjs /opt/riffology/project-resources/text.mjs
COPY --chown=root:root --chmod=0444 services/runtime/controlled-pi.mjs /opt/riffology/runtime/controlled-pi.mjs
COPY --chown=root:root --chmod=0555 services/trusted-pi/trusted-pi-turn-host.mjs /opt/riffology/trusted-pi/trusted-pi-turn-host.mjs
COPY --chown=root:root --chmod=0444 services/trusted-pi/product-model-transport.mjs /opt/riffology/trusted-pi/product-model-transport.mjs
COPY --chown=root:root --chmod=0444 services/trusted-pi/product-tool-bridge.mjs /opt/riffology/trusted-pi/product-tool-bridge.mjs
COPY --chown=root:root --chmod=0444 services/trusted-pi/release-candidate.mjs /opt/riffology/trusted-pi/release-candidate.mjs
COPY --chown=root:root --chmod=0444 services/trusted-pi/release-candidate.mjs /opt/riffology/trusted-pi/trusted-pi-release.mjs

LABEL cn.gaojihe.riffology.release-profile="product-candidate-v1"

COPY --chown=root:root --chmod=0444 services/trusted-pi/research-context.mjs /opt/riffology/trusted-pi/research-context.mjs

COPY --chown=root:root --chmod=0555 services/trusted-pi/runtime_supervisor.py /opt/riffology/runtime_supervisor.py

# Platform-owned IR package; project files cannot discover or replace it.
COPY --chown=root:root vendor/riffoid-ir-plugin/ /opt/riffology/vendor/riffoid-ir-plugin/
COPY --chown=root:root --chmod=0444 services/trusted-pi/ir-package.mjs /opt/riffology/trusted-pi/ir-package.mjs
COPY --chown=root:root --chmod=0444 vendor/riffoid-ir-plugin.lock.json /opt/riffology/vendor/riffoid-ir-plugin.lock.json
