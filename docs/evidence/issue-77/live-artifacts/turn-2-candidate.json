{"schemaVersion":1,"spec":{"schemaVersion":1,"researchQuestion":"How does service time affect FCFS waiting?","scope":"Synthetic deterministic single-server queue","entities":["customers","server"],"mechanisms":["FCFS service"],"assumptions":["Arrival i is seed % 3 + 2*i","One server"],"parameters":{"customers":{"type":"integer","default":5,"minimum":1,"maximum":20},"service_time":{"type":"integer","default":3,"minimum":1,"maximum":5}},"metrics":{"completed":{},"mean_wait":{}},"limitations":["Synthetic deterministic arrivals"],"execution":{"entrypoint":"model/run.py","dependencyLock":"app/requirements.lock"}},"files":{"model/model.py":"\"\"\"Deterministic first-come, first-served single-server queue model.\"\"\"\n\n\ndef run(config):\n    \"\"\"Run the queue and return model snapshots.\"\"\"\n    parameters = config.get(\"parameters\", {})\n    customers = parameters.get(\"customers\", config.get(\"customers\", 5))\n    service_time = parameters.get(\"service_time\", config.get(\"service_time\", 3))\n    seed = config.get(\"seed\", 0)\n\n    snapshots = [{\n        \"schemaVersion\": \"riffology.visual/v0.1\",\n        \"frame\": 0,\n        \"time\": 0,\n        \"space\": {\"type\": \"lane\", \"lanes\": [\"queue\", \"server-1\"]},\n        \"agents\": [],\n        \"metrics\": {\"completed\": 0, \"mean_wait\": 0},\n    }]\n    previous_finish = 0\n    total_wait = 0\n    for index in range(customers):\n        arrival = seed % 3 + 2 * index\n        start = max(arrival, previous_finish)\n        finish = start + service_time\n        total_wait += start - arrival\n        completed = index + 1\n        snapshots.append({\n            \"schemaVersion\": \"riffology.visual/v0.1\",\n            \"frame\": completed,\n            \"time\": finish,\n            \"space\": {\"type\": \"lane\", \"lanes\": [\"queue\", \"server-1\"]},\n            \"agents\": [],\n            \"metrics\": {\"completed\": completed, \"mean_wait\": total_wait / completed},\n        })\n        previous_finish = finish\n    return {\"model\": \"fcfs_queue\", \"snapshots\": snapshots}\n","app/requirements.lock":"{\"schemaVersion\":1,\"packages\":{}}","model/results.json":"[{\"config\":{\"seed\":1,\"steps\":5,\"parameters\":{\"customers\":5,\"service_time\":2}},\"output\":{\"model\":\"fcfs_queue\",\"snapshots\":[{\"schemaVersion\":\"riffology.visual/v0.1\",\"frame\":0,\"time\":0,\"space\":{\"type\":\"lane\",\"lanes\":[\"queue\",\"server-1\"]},\"agents\":[],\"metrics\":{\"completed\":0,\"mean_wait\":0}},{\"schemaVersion\":\"riffology.visual/v0.1\",\"frame\":1,\"time\":3,\"space\":{\"type\":\"lane\",\"lanes\":[\"queue\",\"server-1\"]},\"agents\":[],\"metrics\":{\"completed\":1,\"mean_wait\":0.0}},{\"schemaVersion\":\"riffology.visual/v0.1\",\"frame\":2,\"time\":5,\"space\":{\"type\":\"lane\",\"lanes\":[\"queue\",\"server-1\"]},\"agents\":[],\"metrics\":{\"completed\":2,\"mean_wait\":0.0}},{\"schemaVersion\":\"riffology.visual/v0.1\",\"frame\":3,\"time\":7,\"space\":{\"type\":\"lane\",\"lanes\":[\"queue\",\"server-1\"]},\"agents\":[],\"metrics\":{\"completed\":3,\"mean_wait\":0.0}},{\"schemaVersion\":\"riffology.visual/v0.1\",\"frame\":4,\"time\":9,\"space\":{\"type\":\"lane\",\"lanes\":[\"queue\",\"server-1\"]},\"agents\":[],\"metrics\":{\"completed\":4,\"mean_wait\":0.0}},{\"schemaVersion\":\"riffology.visual/v0.1\",\"frame\":5,\"time\":11,\"space\":{\"type\":\"lane\",\"lanes\":[\"queue\",\"server-1\"]},\"agents\":[],\"metrics\":{\"completed\":5,\"mean_wait\":0.0}}]}},{\"config\":{\"seed\":1,\"steps\":5,\"parameters\":{\"customers\":5,\"service_time\":3}},\"output\":{\"model\":\"fcfs_queue\",\"snapshots\":[{\"schemaVersion\":\"riffology.visual/v0.1\",\"frame\":0,\"time\":0,\"space\":{\"type\":\"lane\",\"lanes\":[\"queue\",\"server-1\"]},\"agents\":[],\"metrics\":{\"completed\":0,\"mean_wait\":0}},{\"schemaVersion\":\"riffology.visual/v0.1\",\"frame\":1,\"time\":4,\"space\":{\"type\":\"lane\",\"lanes\":[\"queue\",\"server-1\"]},\"agents\":[],\"metrics\":{\"c