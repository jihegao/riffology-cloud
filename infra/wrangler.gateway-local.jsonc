{
  "$schema":"../node_modules/wrangler/config-schema.json",
  "name":"riffology-gateway-local",
  "main":"../services/gateway/index.ts",
  "compatibility_date":"2026-09-06",
  "compatibility_flags":["nodejs_compat","nodejs_compat_do_not_populate_process_env"],
  "workers_dev":false,
  "preview_urls":false,
  "assets":{"directory":"../services/web","binding":"ASSETS","run_worker_first":true},
  "secrets":{"required":["BETTER_AUTH_SECRET","GOOGLE_CLIENT_ID","GOOGLE_CLIENT_SECRET"]},
  "vars":{"APP_ORIGIN":"http://127.0.0.1:8795","TENANT_QUOTA_CAPACITY":"1","TENANT_QUOTA_POLICY_VERSION":"m1-v1","M2_TURNS_ENABLED":"false"},
  "d1_databases":[{"binding":"CATALOG","database_name":"riffology-catalog-local","database_id":"local-catalog","migrations_dir":"../services/catalog/migrations"}],
  "durable_objects":{"bindings":[{"name":"TENANT_QUOTA","class_name":"TenantQuota"},{"name":"WORKSPACE_AGENT","class_name":"WorkspaceAgent"},{"name":"PROJECT_RUNTIME","class_name":"ProjectRuntime"},{"name":"PRODUCT_TURN_RUNTIME","class_name":"ProductTurnRuntime"},{"name":"REVISION_STORE","class_name":"RevisionStore"}]},
  "containers":[{"name":"riffology-project-local","class_name":"ProjectRuntime","image":"../services/runtime/Dockerfile.local","instance_type":"lite","max_instances":1}],
  "exports":{
    "TenantQuota":{"type":"durable-object","storage":"sqlite"},
    "WorkspaceAgent":{"type":"durable-object","storage":"sqlite"},
    "ProjectRuntime":{"type":"durable-object","storage":"sqlite","container":"riffology-project-local"},
    "ProductTurnRuntime":{"type":"durable-object","storage":"sqlite"},
    "RevisionStore":{"type":"durable-object","storage":"sqlite"}
  },
  "r2_buckets":[{"binding":"WORKSPACE_CHECKPOINTS","bucket_name":"riffology-workspace-local"},{"binding":"MODEL_CONTENT","bucket_name":"riffology-model-content-local"}],
  "triggers":{"crons":["* * * * *"]},
  "observability":{"enabled":true},
  "dev":{"ip":"127.0.0.1","port":8795}
}
