{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "riffology-m0-files",
  "main": "../spikes/m0-files/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_do_not_populate_process_env"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "riffology-m0-files-staging",
      "account_id": "8b0d70250211aa10d89e20605a1c7e5e",
      "workers_dev": true,
      "vars": { "ENVIRONMENT": "staging", "PROTOCOL_VERSION": "m0-v1", "M0_EXECUTION_ENVIRONMENT": "cloudflare-vm" },
      "secrets": { "required": ["M0_PROBE_TOKEN"] },
      "r2_buckets": [{ "binding": "CHECKPOINTS", "bucket_name": "riffology-m0-checkpoints-staging" }],
      "containers": [{ "name": "riffology-m0-files-project-staging", "image": "docker.io/jihegao/riffology-m0-project@sha256:c010768e37d6ad06da137308d30faf32b9ec7fcc21916f29f146c281c7a6946e", "instance_type": "basic", "max_instances": 2 }],
      "exports": {
        "M0FilesCoordinator": { "type": "durable-object", "storage": "sqlite" },
        "FileProjectSandbox": { "type": "durable-object", "storage": "sqlite", "container": "riffology-m0-files-project-staging" }
      },
      "durable_objects": { "bindings": [
        { "name": "FILES", "class_name": "M0FilesCoordinator" },
        { "name": "FileProjectSandbox", "class_name": "FileProjectSandbox" }
      ] }
    }
  }
}
