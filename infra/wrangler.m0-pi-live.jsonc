{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "riffology-m0-pi-live",
  "main": "../spikes/m0-pi-live/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_do_not_populate_process_env",
    "enable_request_signal",
    "request_signal_passthrough"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "riffology-m0-pi-live-staging",
      "account_id": "8b0d70250211aa10d89e20605a1c7e5e",
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "staging",
        "PROTOCOL_VERSION": "m0-v1"
      },
      "secrets": {
        "required": [
          "M0_PROBE_TOKEN",
          "M0_MODEL_PROXY_OPERATOR_TOKEN"
        ]
      },
      "containers": [
        {
          "name": "riffology-m0-pi-live-trusted-staging",
          "image": "docker.io/jihegao/riffology-m0-trusted-proxy@sha256:4be14ca3e2191e2a2941d4eb0ff7ac904c5a694b60ee839f75ac429eac7f3e67",
          "instance_type": "basic",
          "max_instances": 1
        },
        {
          "name": "riffology-m0-pi-live-project-staging",
          "image": "docker.io/jihegao/riffology-m0-project@sha256:c010768e37d6ad06da137308d30faf32b9ec7fcc21916f29f146c281c7a6946e",
          "instance_type": "basic",
          "max_instances": 1
        }
      ],
      "exports": {
        "TrustedPiSandbox": {
          "type": "durable-object",
          "storage": "sqlite",
          "container": "riffology-m0-pi-live-trusted-staging"
        },
        "ProjectSandbox": {
          "type": "durable-object",
          "storage": "sqlite",
          "container": "riffology-m0-pi-live-project-staging"
        },
        "M0PiLive": {
          "type": "durable-object",
          "storage": "sqlite"
        }
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "TrustedPiSandbox",
            "class_name": "TrustedPiSandbox"
          },
          {
            "name": "ProjectSandbox",
            "class_name": "ProjectSandbox"
          },
          {
            "name": "HOST",
            "class_name": "M0PiLive"
          }
        ]
      },
      "services": [
        {
          "binding": "MODEL_PROXY",
          "service": "riffology-m0-model-proxy-go-live-staging"
        }
      ],
      "r2_buckets": [
        {
          "binding": "CHECKPOINTS",
          "bucket_name": "riffology-m0-checkpoints-staging"
        }
      ]
    }
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/go-pi-probe.mjs",
        "**/egress-probe.mjs"
      ],
      "fallthrough": true
    }
  ]
}
