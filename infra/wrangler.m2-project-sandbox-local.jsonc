{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "riffology-m2-project-sandbox-local",
  "main": "../spikes/m2-project-sandbox/index.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_do_not_populate_process_env"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "PROJECT_SANDBOX", "class_name": "ProjectToolSandbox" },
      { "name": "TRUSTED_PI_SANDBOX", "class_name": "TrustedPiSandbox" },
      { "name": "TOOL_BRIDGE_AGENT", "class_name": "ToolBridgeAgent" },
      { "name": "TOOL_ARTIFACT_STORE", "class_name": "ToolArtifactStore" }
    ]
  },
  "services": [
    {
      "binding": "TOOL_BRIDGE",
      "service": "riffology-m2-project-sandbox-local",
      "entrypoint": "ToolBridgeService"
    },
    {
      "binding": "MODEL_PROXY",
      "service": "riffology-m2-project-sandbox-local",
      "entrypoint": "ToolBridgeService"
    }
  ],
  "containers": [
    {
      "name": "riffology-m2-project-sandbox-local",
      "class_name": "ProjectToolSandbox",
      "image": "../services/project-tools/Dockerfile.cloud",
      "instance_type": "lite",
      "max_instances": 1
    },
    {
      "name": "riffology-m2-trusted-pi-local",
      "class_name": "TrustedPiSandbox",
      "image": "../Dockerfile.trusted-pi.cloud",
      "instance_type": "lite",
      "max_instances": 1
    }
  ],
  "exports": {
    "ProjectToolSandbox": {
      "type": "durable-object",
      "storage": "sqlite",
      "container": "riffology-m2-project-sandbox-local"
    },
    "TrustedPiSandbox": {
      "type": "durable-object",
      "storage": "sqlite",
      "container": "riffology-m2-trusted-pi-local"
    },
    "ToolBridgeAgent": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "ToolArtifactStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "r2_buckets": [
    { "binding": "WORKSPACE_CHECKPOINTS", "bucket_name": "riffology-workspace-local" }
  ],
  "dev": { "ip": "127.0.0.1", "port": 8796 }
}
