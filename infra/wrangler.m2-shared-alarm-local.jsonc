{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "riffology-m2-shared-alarm-local",
  "main": "../spikes/m2-shared-alarm/index.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_do_not_populate_process_env"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "SHARED_ALARM_PROBE", "class_name": "SharedAlarmProbe" }
    ]
  },
  "exports": {
    "SharedAlarmProbe": { "type": "durable-object", "storage": "sqlite" }
  },
  "dev": { "ip": "127.0.0.1", "port": 8797 }
}
