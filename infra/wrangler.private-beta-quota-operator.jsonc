{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "riffology-private-beta-quota-operator",
  "main": "../scripts/model/private-beta-quota-operator.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {"enabled": true, "head_sampling_rate": 1},
  "secrets": {"required": ["PRIVATE_BETA_QUOTA_OPERATOR_CAPABILITY"]},
  "vars": {"PRIVATE_BETA_QUOTA_OPERATOR_SCOPE_JSON": "{}"},
  "durable_objects": {"bindings": [{
    "name": "PRIVATE_BETA_CAPACITY",
    "class_name": "PrivateBetaCapacity",
    "script_name": "riffology-m1-gateway-staging"
  }]}
}
