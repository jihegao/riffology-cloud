{
  "name": "riffology-cloud",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ui/serve.mjs",
    "check": "npm run check:ui && npm run typecheck && npm run test:m0 && npm run test:m1 && npm run test:m2 && npm run test:m3",
    "check:ui": "node --check ui/app.js && node --check ui/workspace.js && node --check ui/user-pages.js && node --check ui/admin.js && node --check ui/shared.js && node --check services/web/app.js && node --check services/web/services.js && node --check services/web/previews.js && node --check services/web/admin.js && node --check services/web/simulation.js",
    "typecheck": "tsc --noEmit",
    "test:m0": "node --test tests/m0/*.test.ts tests/m0/*.test.mjs tests/m0/pi/*.test.mjs spikes/m0-cloud/*.test.ts spikes/m0-files/*.test.ts spikes/m0-preview/*.test.ts spikes/m0-recovery/*.test.ts spikes/m0-release/*.test.ts scripts/m0/release-manifest.test.mjs && node scripts/evidence/self-test.mjs && node scripts/m0/preflight-self-test.mjs",
    "m0:preflight": "node scripts/m0/preflight.mjs",
    "m0:storage:dev": "wrangler dev --config infra/wrangler.m0-storage.jsonc --env staging --local --port 8788 --ip 127.0.0.1",
    "m0:boundary:dev": "wrangler dev --config infra/wrangler.m0.jsonc --env staging --local --port 8789 --ip 127.0.0.1",
    "m0:boundary:integration": "node scripts/m0/boundary-local.mjs",
    "m0:record-checks": "node scripts/m0/record-local-checks.mjs",
    "m0:files:dev": "wrangler dev --config infra/wrangler.m0-files.jsonc --env staging --local --port 8790 --ip 127.0.0.1 --var M0_EXECUTION_ENVIRONMENT:local-docker-workerd",
    "m0:preview:integration": "node scripts/m0/preview-browser.mjs",
    "m0:preview:browser": "node scripts/m0/preview-browser.mjs",
    "m0:release": "node scripts/m0/release-manifest.mjs",
    "m0:recovery:dev": "wrangler dev --config infra/wrangler.m0-recovery.jsonc --env staging --local --port 8793 --ip 127.0.0.1 --var M0_EXECUTION_ENVIRONMENT:local-docker-workerd",
    "m0:recovery:integration": "node scripts/m0/recovery-local.mjs",
    "test:m1": "node --test tests/m1/*.test.ts tests/m1/*.test.mjs scripts/m1/model-package.test.mjs",
    "test:m3": "node --test tests/m3/*.test.ts tests/m3/*.test.mjs && node --test scripts/m3/phase1-*.test.mjs",
    "test:m2": "node --test tests/m2/*.test.ts tests/m2/*.test.mjs",
    "m1:dev": "wrangler dev --config infra/wrangler.gateway-local.jsonc --local",
    "m1:bootstrap:operator": "node scripts/m1/bootstrap-operator.mjs",
    "m1:model-package": "node scripts/m1/model-package.mjs",
    "m1:model-content:local": "node scripts/m1/check-workspace-local.mjs",
    "m1:preflight:staging": "node scripts/m1/staging-preflight.mjs",
    "m2:product-turn:local": "node scripts/m2/check-product-turn-local.mjs",
    "m3:vertical:preflight": "node scripts/m3/vertical-runtime-preflight.mjs",
    "m3:vertical:start": "node scripts/m3/vertical-runtime-preflight.mjs --launch",
    "m3:vertical:preflight:staging": "node scripts/m3/vertical-staging-preflight.mjs",
    "m3:vertical:release:staging": "node scripts/m3/vertical-staging-release.mjs",
    "m3:issues:acceptance:staging": "node scripts/m3/issues-controlled-release-acceptance.mjs",
    "m3:issues:reconcile:staging": "node scripts/m3/issues-acceptance-reconcile.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260905.1",
    "@types/node": "25.3.0",
    "playwright": "^1.63.0",
    "typescript": "7.0.2",
    "wrangler": "4.129.0",
    "ws": "8.21.0"
  },
  "dependencies": {
    "@cloudflare/sandbox": "0.12.9",
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@earendil-works/pi-server": "0.85.0",
    "better-auth": "1.7.3",
    "undici": "7.29.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
