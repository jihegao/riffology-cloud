FROM node:22.19.0-bookworm-slim@sha256:cff78eb5aa1cf27dc2b6aeea9d31366415a43e9a9ea0ddec00d780b2b66fad0f

USER root
RUN mkdir -p /workspace && chown node:node /workspace
WORKDIR /workspace
USER node

# Wrangler's local container supervisor requires one declared port even though
# ProjectRuntime is reached only through Durable Object RPC and starts with
# enableInternet:false.
EXPOSE 8080

# ProjectRuntime always supplies a fixed platform entrypoint. This idle command
# keeps an accidentally direct start inert and gives the container no network or
# project behavior of its own.
CMD ["node", "-e", "setInterval(()=>{},2147483647)"]
